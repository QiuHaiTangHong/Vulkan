{
  "dependencies": {
    "glfw": {
      "url": "https://github.com/glfw/glfw.git",
      "tag": "3.4",
      "cmake_args": [
        "-DGLFW_BUILD_DOCS=OFF",
        "-DGLFW_BUILD_EXAMPLES=OFF"
      ]
    },
    "glm": {
      "url": "https://github.com/g-truc/glm.git",
      "tag": "1.0.3",
      "cmake_args": [
        "-DGLM_TEST_ENABLE=OFF",
        "-DGLM_BUILD_LIBRARY=OFF"
      ],
      "skip_build": true
    },
    "imgui": {
      "url": "https://github.com/ocornut/imgui.git",
      "tag": "v1.92.6",
      "files": [
        "imconfig.h",
        "imgui.h",
        "imgui.cpp",
        "imgui_draw.cpp",
        "imgui_internal.h",
        "imgui_tables.cpp",
        "imgui_widgets.cpp",
        "imgui_demo.cpp",
        "imstb_rectpack.h",
        "imstb_textedit.h",
        "imstb_truetype.h",
        "backends/imgui_impl_glfw.h",
        "backends/imgui_impl_glfw.cpp",
        "backends/imgui_impl_vulkan.h",
        "backends/imgui_impl_vulkan.cpp"
      ],
      "only_copy": true
    },
    "Vulkan-Utility-Libraries": {
      "url": "https://github.com/KhronosGroup/Vulkan-Utility-Libraries.git",
      "tag": "vulkan-sdk-1.4.341.0",
      "cmake_args": [
        "-DBUILD_TESTS=OFF",
        "-DUPDATE_DEPS=ON"
      ]
    },
    "Vulkan-Headers": {
      "url": "https://github.com/KhronosGroup/Vulkan-Headers.git",
      "tag": "vulkan-sdk-1.4.341.0",
      "cmake_args": [],
      "skip_build": true
    },
    "Vulkan-ValidationLayers": {
      "url": "https://github.com/KhronosGroup/Vulkan-ValidationLayers.git",
      "tag": "vulkan-sdk-1.4.341.0",
      "cmake_args": [
        "-DUPDATE_DEPS=ON",
        "-DBUILD_WERROR=OFF",
        "-DBUILD_TESTS=OFF"
      ]
    },
    "glslang": {
      "url": "https://github.com/KhronosGroup/glslang.git",
      "tag": "vulkan-sdk-1.4.341.0",
      "cmake_args": [],
      "parent_command": [
        "${current_src_path}/update_glslang_sources.py"
      ]
    },
    "Vulkan-Loader": {
      "url": "https://github.com/KhronosGroup/Vulkan-Loader.git",
      "tag": "vulkan-sdk-1.4.341.0",
      "cmake_args": [
        "-DUPDATE_DEPS=ON",
        "-DBUILD_TESTS=OFF",
        "-DUSE_ASSEMBLY_FALLBACK=ON"
      ]
    }
  },
  "install_root_path": "${project_root}/lib",
  "generator": "Ninja",
  "build_type": "Debug",
  "global_cmake_args": [
    "$Linux:-DCMAKE_C_COMPILER=clang",
    "$Linux:-DCMAKE_CXX_COMPILER=clang++",
    "$Win:-DCMAKE_C_COMPILER=clang-cl.exe",
    "$Win:-DCMAKE_CXX_COMPILER=clang-cl.exe",
    "-DCMAKE_BUILD_TYPE=${build_type}",
    "-DBUILD_WERROR=OFF",
    "-DCMAKE_C_FLAGS=-w $Win:-DWIN32",
    "-DCMAKE_CXX_FLAGS=-w $Win:-DWIN32"
  ]
}